<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:design="clr-namespace:Phiale.Design.Wpf">
    <Geometry x:Key="Phiale.Design.Geometry.Chevron.Down">M1,4 L7,10 13,4</Geometry>
    <Geometry x:Key="Phiale.Design.Geometry.Chevron.Up">M1,10 L7,4 13,10</Geometry>
    <Geometry x:Key="Phiale.Design.Geometry.Chevron.Right">M4,1 L10,7 4,13</Geometry>
    <Geometry x:Key="Phiale.Design.Geometry.Chevron.Left">M10,1 L4,7 10,13</Geometry>
    <Style x:Key="Phiale.Design.Style.ChevronGlyph" TargetType="ContentControl">
        <Setter Property="Width" Value="{DynamicResource Phiale.Design.Size.DisclosureGlyph}"/>
        <Setter Property="Height" Value="{DynamicResource Phiale.Design.Size.DisclosureGlyph}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform"><Canvas Width="14" Height="14" SnapsToDevicePixels="False">
                        <Path x:Name="Chevron" Data="{StaticResource Phiale.Design.Geometry.Chevron.Right}"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="{DynamicResource Phiale.Design.Size.ChevronStroke}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas></Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="design:ChevronVisual.Direction" Value="Down"><Setter TargetName="Chevron" Property="Data" Value="{StaticResource Phiale.Design.Geometry.Chevron.Down}"/></Trigger>
                        <Trigger Property="design:ChevronVisual.Direction" Value="Up"><Setter TargetName="Chevron" Property="Data" Value="{StaticResource Phiale.Design.Geometry.Chevron.Up}"/></Trigger>
                        <Trigger Property="design:ChevronVisual.Direction" Value="Left"><Setter TargetName="Chevron" Property="Data" Value="{StaticResource Phiale.Design.Geometry.Chevron.Left}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>