<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:design="clr-namespace:Phiale.Design.Wpf">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolCards.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="Phiale.Design.Style.Panel.Surface" TargetType="Border" BasedOn="{StaticResource Phiale.Design.Style.Surface.Card}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Phiale.Design.Radius.Panel.Surface}"/>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Workspace.Light}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="design:ThemeScope.Mode" Value="Light"><Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Workspace.Light}"/></Trigger>
            <Trigger Property="design:ThemeScope.Mode" Value="Dark"><Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Workspace.Dark}"/></Trigger>
            <Trigger Property="design:ThemeScope.Mode" Value="HighContrast"><Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Workspace.HighContrast}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Phiale.Design.Style.Panel.Header" TargetType="Border" BasedOn="{StaticResource Phiale.Design.Style.ToolCard.Header}">
        <Setter Property="CornerRadius" Value="{DynamicResource Phiale.Design.Radius.Panel.Header}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Subtle.Light}"/>
        <Style.Triggers>
            <Trigger Property="design:ThemeScope.Mode" Value="Dark"><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Subtle.Dark}"/></Trigger>
            <Trigger Property="design:ThemeScope.Mode" Value="HighContrast"><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Subtle.HighContrast}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Phiale.Design.Style.Panel.Splitter" TargetType="Thumb">
        <Setter Property="Width" Value="{DynamicResource Phiale.Design.Size.Workspace.SplitterHitWidth}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Accent.Light}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.Light}"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                    <Border x:Name="Track" Width="{DynamicResource Phiale.Design.Size.Panel.SplitterIndicator}"
                            HorizontalAlignment="Center" Background="{TemplateBinding Foreground}" CornerRadius="1" Opacity="0"/>
                    <Border x:Name="Grip" Width="4" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="2" Background="{DynamicResource Phiale.Design.Brush.Surface.Workspace.Light}" TextElement.Foreground="{DynamicResource Phiale.Design.Brush.Text.Muted.Light}" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="GripDot1" Width="2" Height="2" Margin="0,0,0,3" Fill="{Binding (TextElement.Foreground), ElementName=Grip}"/>
                            <Ellipse x:Name="GripDot2" Width="2" Height="2" Margin="0,0,0,3" Fill="{Binding (TextElement.Foreground), ElementName=Grip}"/>
                            <Ellipse x:Name="GripDot3" Width="2" Height="2" Fill="{Binding (TextElement.Foreground), ElementName=Grip}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="design:SplitterVisual.Orientation" Value="Horizontal">
                        <Setter TargetName="Track" Property="Width" Value="Auto"/>
                        <Setter TargetName="Track" Property="Height" Value="{DynamicResource Phiale.Design.Size.Panel.SplitterIndicator}"/>
                        <Setter TargetName="Track" Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter TargetName="Track" Property="VerticalAlignment" Value="Center"/>
                        <Setter TargetName="Grip" Property="LayoutTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                    </Trigger>
                    <Trigger Property="design:ThemeScope.Mode" Value="Dark"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Workspace.Dark}"/><Setter TargetName="Grip" Property="TextElement.Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Muted.Dark}"/></Trigger>
                    <Trigger Property="design:ThemeScope.Mode" Value="HighContrast">
                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Workspace.HighContrast}"/><Setter TargetName="Grip" Property="TextElement.Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.HighContrast}"/>
                        <Setter TargetName="Track" Property="Opacity" Value="1"/>
                        <Setter TargetName="Track" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="1"/><Setter TargetName="Track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Track" Property="Opacity" Value="1"/><Setter TargetName="Track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Opacity" Value="1"/><Setter TargetName="Track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="design:SplitterVisual.Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="{DynamicResource Phiale.Design.Size.Workspace.SplitterHitWidth}"/><Setter Property="Cursor" Value="SizeNS"/></Trigger>
            <Trigger Property="design:ThemeScope.Mode" Value="Dark"><Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Accent.Dark}"/><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.Dark}"/></Trigger>
            <Trigger Property="design:ThemeScope.Mode" Value="HighContrast"><Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.HighContrast}"/><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.HighContrast}"/></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>