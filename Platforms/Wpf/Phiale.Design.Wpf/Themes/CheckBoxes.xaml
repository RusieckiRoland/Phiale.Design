<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:design="clr-namespace:Phiale.Design.Wpf">
  <Style x:Key="Phiale.Design.Style.CheckBox" TargetType="CheckBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Light}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Strong.Light}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Phiale.Design.Text.Body.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Phiale.Design.Text.BodySmall.FontSize}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="MinHeight" Value="{DynamicResource Phiale.Design.Internal.Size.Control.MinHeight}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="{DynamicResource Phiale.Design.Radius.Medium}" Padding="{TemplateBinding Padding}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="{DynamicResource Phiale.Design.Size.CheckBox}" Height="{DynamicResource Phiale.Design.Size.CheckBox}"
                    Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource Phiale.Design.Thickness.Border.Default}"
                    CornerRadius="{DynamicResource Phiale.Design.Radius.CheckBox}" VerticalAlignment="Center">
              <Viewbox Width="12" Height="12"><Canvas Width="12" Height="12">
                <Path x:Name="Mark" Visibility="Collapsed" Data="M 2,6 L 5,9 10,3" Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas></Viewbox>
            </Border>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="HasContent" Value="False"><Setter TargetName="Content" Property="Margin" Value="0"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="design:ThemeScope.Mode" Value="HighContrast"><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.Light}"/>
            <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.Light}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Light}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.Dark}"/>
            <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.Dark}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Dark}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.HighContrast}"/>
            <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.HighContrast}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.HighContrast}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Disabled.Fill.Light}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Disabled.Border.Light}"/>
            <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.Light}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Disabled.Fill.Dark}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Disabled.Border.Dark}"/>
            <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.Dark}"/>
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Disabled.Fill.HighContrast}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Disabled.Border.HighContrast}"/>
            <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.HighContrast}"/>
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Light}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Light}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.Light}"/>
        <Setter Property="Opacity" Value="1"/><Setter Property="Cursor" Value="Arrow"/>
      </MultiTrigger>
      <Trigger Property="design:ThemeScope.Mode" Value="Dark"><Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Dark}"/><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Strong.Dark}"/></Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Dark}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Dark}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.Dark}"/>
        <Setter Property="Opacity" Value="1"/><Setter Property="Cursor" Value="Arrow"/>
      </MultiTrigger>
      <Trigger Property="design:ThemeScope.Mode" Value="HighContrast"><Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.HighContrast}"/><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Strong.HighContrast}"/></Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.HighContrast}"/>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.HighContrast}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.HighContrast}"/>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.HighContrast}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.HighContrast}"/>
        <Setter Property="Opacity" Value="1"/><Setter Property="Cursor" Value="Arrow"/>
      </MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
