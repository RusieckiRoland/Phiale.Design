        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Scroll.Thumb.HighContrast}" />
        </MultiTrigger>
        <Trigger Property="IsEnabled" Value="False">        <Setter Property="Opacity" Value="{DynamicResource Phiale.Design.Opacity.Disabled}" /></Trigger>
        <Trigger Property="Orientation" Value="Vertical">        <Setter Property="Width" Value="{DynamicResource Phiale.Design.Internal.Size.ScrollBar.Thickness}" /></Trigger>
        <Trigger Property="Orientation" Value="Horizontal">        <Setter Property="Height" Value="{DynamicResource Phiale.Design.Internal.Size.ScrollBar.Thickness}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Phiale.Design.Style.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                    Style="{StaticResource Phiale.Design.Style.ScrollBar}" Maximum="{TemplateBinding ScrollableHeight}"
                    ViewportSize="{TemplateBinding ViewportHeight}" LargeChange="{TemplateBinding ViewportHeight}"
                    Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                    Style="{StaticResource Phiale.Design.Style.ScrollBar}" Maximum="{TemplateBinding ScrollableWidth}"
                    ViewportSize="{TemplateBinding ViewportWidth}" LargeChange="{TemplateBinding ViewportWidth}"
                    Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Phiale.Design.Internal.ComboBoxScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollViewer">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" MinWidth="0" MinHeight="0"
                               Width="{DynamicResource Phiale.Design.Internal.Size.ScrollBar.Thickness}"
                               Style="{StaticResource Phiale.Design.Style.ScrollBar}"
                               Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                               LargeChange="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="Phiale.Design.Style.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.Light}" />
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Light}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Phiale.Design.Thickness.Border.Default}" />
        <Setter Property="Padding" Value="{DynamicResource Phiale.Design.Internal.Thickness.TextInput.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Phiale.Design.Internal.Size.Control.MinHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource Phiale.Design.Text.Body.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Phiale.Design.Text.Body.FontSize}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Phiale.Design.Internal.ComboBoxItem}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Phiale.Design.Radius.Medium}" />
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter x:Name="Selection" Margin="{DynamicResource Phiale.Design.Thickness.ComboBox.Content.Margin}" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center"/>
              <Grid Grid.Column="1" Width="{DynamicResource Phiale.Design.Size.ComboBox.DisclosureWidth}">
                <ContentControl x:Name="DropDownChevron" Style="{StaticResource Phiale.Design.Style.ChevronGlyph}"
                                Foreground="{TemplateBinding Foreground}" design:ChevronVisual.Direction="Down"/>
              </Grid>
              <TextBox x:Name="PART_EditableTextBox" Margin="{DynamicResource Phiale.Design.Thickness.ComboBox.Content.Margin}" Padding="0" VerticalContentAlignment="Center"
                       Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Visibility="Hidden"
                       IsReadOnly="{TemplateBinding IsReadOnly}" BorderThickness="0"/>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
              <Border x:Name="DropDownSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Phiale.Design.Radius.Medium}"
                      design:ThemeScope.Mode="{TemplateBinding design:ThemeScope.Mode}"
                      TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer x:Name="DropDownScrollViewer" Style="{StaticResource Phiale.Design.Internal.ComboBoxScrollViewer}" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">

                  <ScrollViewer.Clip>
                    <MultiBinding Converter="{StaticResource Phiale.Design.Internal.RoundedContentClip}">
                      <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                      <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                      <Binding Path="CornerRadius" ElementName="DropDownSurface"/>
                      <Binding Path="BorderThickness" ElementName="DropDownSurface"/>
                    </MultiBinding>
                  </ScrollViewer.Clip>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="DropDownChevron" Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Light}"/><Setter TargetName="DropDownSurface" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}"/></MultiTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="DropDownChevron" Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Dark}"/><Setter TargetName="DropDownSurface" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.Dark}"/></MultiTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="DropDownChevron" Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.HighContrast}"/><Setter TargetName="DropDownSurface" Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.HighContrast}"/></MultiTrigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="DropDownChevron" Property="design:ChevronVisual.Direction" Value="Up"/></Trigger><Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Hidden" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="design:ThemeScope.Mode" Value="Light" />
          </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.Light}" />
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Light}" />
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="design:ThemeScope.Mode" Value="Light" />
            <Condition Property="IsKeyboardFocusWithin" Value="True" />
          </MultiTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Light}" />
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="design:ThemeScope.Mode" Value="Dark" />
          </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.Dark}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.Dark}" />
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Dark}" />
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="design:ThemeScope.Mode" Value="Dark" />
            <Condition Property="IsKeyboardFocusWithin" Value="True" />
          </MultiTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Dark}" />
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="design:ThemeScope.Mode" Value="HighContrast" />
          </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Surface.Base.HighContrast}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Border.Default.HighContrast}" />
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.HighContrast}" />
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="design:ThemeScope.Mode" Value="HighContrast" />
            <Condition Property="IsKeyboardFocusWithin" Value="True" />
          </MultiTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.HighContrast}" />
        </MultiTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Light}"/><Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Light}"/></MultiTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Dark}"/><Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Dark}"/></MultiTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.HighContrast}"/><Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.HighContrast}"/></MultiTrigger>
        <Trigger Property="IsEnabled" Value="False">        <Setter Property="Opacity" Value="{DynamicResource Phiale.Design.Opacity.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

