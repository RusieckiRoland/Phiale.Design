<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:design="clr-namespace:Phiale.Design.Wpf">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="Phiale.Design.Style.ChevronButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Phiale.Design.Size.ChevronButton}"/>
        <Setter Property="Height" Value="{DynamicResource Phiale.Design.Size.ChevronButton}"/>
        <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Phiale.Design.Thickness.Border.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Light}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Phiale.Design.Radius.Medium}">
                        <Viewbox Width="{DynamicResource Phiale.Design.Size.ChevronIcon}" Height="{DynamicResource Phiale.Design.Size.ChevronIcon}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="12" Height="12">
                                <Path x:Name="Chevron" Data="M 4,2 L 8,6 4,10" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{DynamicResource Phiale.Design.Size.ChevronStroke}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="design:ChevronVisual.Direction" Value="Left"><Setter TargetName="Chevron" Property="Data" Value="M 8,2 L 4,6 8,10"/></Trigger>
                        <Trigger Property="design:ChevronVisual.Direction" Value="Up"><Setter TargetName="Chevron" Property="Data" Value="M 2,8 L 6,4 10,8"/></Trigger>
                        <Trigger Property="design:ChevronVisual.Direction" Value="Down"><Setter TargetName="Chevron" Property="Data" Value="M 2,4 L 6,8 10,4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Light}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Light}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Light}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Light"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.Light}"/>
            </MultiTrigger>
            <Trigger Property="design:ThemeScope.Mode" Value="Dark"><Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.Dark}"/></Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Dark}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Hover.Fill.Dark}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.Dark}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="Dark"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.Dark}"/>
            </MultiTrigger>
            <Trigger Property="design:ThemeScope.Mode" Value="HighContrast"><Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Text.Primary.HighContrast}"/></Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.HighContrast}"/>
                <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.HighContrast}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Fill.HighContrast}"/>
                <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Selection.Active.Text.HighContrast}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Phiale.Design.Brush.Focus.Ring.HighContrast}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="design:ThemeScope.Mode" Value="HighContrast"/><Condition Property="IsEnabled" Value="False"/></MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Phiale.Design.Brush.Disabled.Text.HighContrast}"/>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="{DynamicResource Phiale.Design.Internal.Opacity.Pressed}"/></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
